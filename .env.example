# --- Provider selection ----------------------------------------------------
# Pick one provider; LLM_MODEL overrides the provider's default model.
# Auto-detection: if LLM_MODEL is `gemini/...`, `anthropic/...`, `openai/...`,
# `openrouter/...`, or `bedrock/...`, the provider is inferred from the prefix.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-pro

# Extended-thinking budget (ignored on models that don't support thinking).
THINKING_BUDGET_TOKENS=12000

# --- Provider API keys (set whichever you use) -----------------------------
# Google Gemini -- https://aistudio.google.com/app/apikey  (free tier, no card)
GEMINI_API_KEY=

# Anthropic -- https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI -- https://platform.openai.com/api-keys
OPENAI_API_KEY=

# OpenRouter -- https://openrouter.ai/keys (single key, hundreds of models)
OPENROUTER_API_KEY=

# --- AWS Bedrock (only if LLM_PROVIDER=bedrock) ----------------------------
AWS_REGION=us-east-1
# Either standard AWS creds (AWS_ACCESS_KEY_ID/...) or a Bedrock long-term API
# key starting with ABSK (auto-mapped to AWS_BEARER_TOKEN_BEDROCK):
BEDROCK_API_KEY=
# BEDROCK_MODEL_ID is honored as a fallback for LLM_MODEL on the bedrock provider.
# BEDROCK_MODEL_ID=us.meta.llama4-maverick-17b-instruct-v1:0
