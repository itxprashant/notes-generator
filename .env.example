# AWS region where your Bedrock model access is enabled.
AWS_REGION=us-east-1

# Bedrock model / cross-region inference profile ID. Default below works
# without an AWS Marketplace subscription. Other vision-capable options:
#   us.anthropic.claude-opus-4-6-v1                 (best for math, but needs payment instrument)
#   us.meta.llama4-maverick-17b-instruct-v1:0       (default; Llama 4 MoE, vision)
#   us.meta.llama4-scout-17b-instruct-v1:0          (smaller Llama 4)
#   us.amazon.nova-pro-v1:0                         (Amazon flagship - prone to repetition loops on dense math)
#   us.amazon.nova-2-lite-v1:0                      (cheaper Nova)
#   us.mistral.pixtral-large-2502-v1:0              (Mistral vision)
BEDROCK_MODEL_ID=us.meta.llama4-maverick-17b-instruct-v1:0

# Extended-thinking budget per Bedrock call. Only used for Claude models;
# silently ignored on Nova / Llama / Mistral.
THINKING_BUDGET_TOKENS=12000

# Auth: either a long-term Bedrock API key (preferred):
# BEDROCK_API_KEY=ABSK...
# (the pipeline copies this into AWS_BEARER_TOKEN_BEDROCK at startup)
# Or standard AWS env vars:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# AWS_PROFILE=
